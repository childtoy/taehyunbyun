@article{byun2025adaptivehdm,
      author={Byun, Taehyun and Lee, Seulbi and Lee, Kyungjae and Hwang, Sangheum and Choi, Sungjoon},
      title={Adaptive Hilbert Diffusion Models for Controllable Smoothness in Continuous Function Generation},
      journal={Computational Visual Media},
      abbr={CVM},
      year={2025},
      abstract={We introduce Adaptive Hilbert Diffusion Models (AdaptiveHDM), a method for generating continuous functions such as human motions using diffusion models with adjustable smoothness control. Our approach uses a Length Prediction Module (LPM) to estimate the smoothness of the input sequence and leverages Hilbert space structures with multiple kernels. The technique enables fine-grained control in generative models without requiring smoothness labels in training data, with applications demonstrated on synthetic data and motion generation tasks.},
      website={https://childtoy.github.io/AdaptiveHDM-page/},
      selected={true},
      note={Accepted, IF 18.3},
}

@article{byun2025csms,
      author={Byun, Taehyun and Kim, Sunwoo and Chang, Minwook and Choi, Sungjoon},
      title={Controllable Single Motion Synthesis},
      journal={Pattern Recognition},
      abbr={PR},
      year={2025},
      abstract={We tackle motion synthesis from limited data by introducing a two-stage approach. Our method enables the creation of variations that maintain desired actions while introducing diversity in timing and movement. We first expand datasets using an unconditioned diffusion model with automatic labeling, then apply a conditioned diffusion model for precise control. Our U-Net based architecture accommodates varying sequence lengths in our diffusion model, allowing generation of motion sequences at any desired length while preserving semantic meaning.},
      website={https://childtoy.github.io/csms.github.io/},
      selected={true},
      note={Conditional Accepted},
}

@article{byun2026effective,
      author={Byun, Taehyun and Kim, Chanwoo and Lim, Bokman and Suh, Sungho and Choi, Sungjoon},
      title={Effective Evaluation of Exoskeleton Using Exo-Agnostic Uncertainty-Aware Classification Model with Wearable Sensors},
      journal={ACM Augmented Humans (AHs)},
      abbr={AHs2026},
      publisher={ACM},
      year={2026},
      abstract={Evaluating hip exoskeleton-assisted gait in real-world environments remains challenging, as conventional approaches rely on lab-based biomechanical measurements or subjective reports. This work proposes a lightweight, wearable-sensor-based metric for characterizing how exoskeleton assistance reshapes an individual’s walking pattern relative to their baseline. We introduce an uncertainty-aware, exoskeleton-agnostic classification framework trained exclusively on exoskeleton-off data to distinguish normal from perturbed gait.},
      selected={true},
}
